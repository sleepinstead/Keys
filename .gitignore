# Keys: what never goes into git. Applies to every folder (keys-web, keys-extension).

# ---------------------------------------------------------------- dependencies
node_modules/
.pnpm-store/
.yarn/
.npm/

# ---------------------------------------------------------------- build output
dist/
build/
out/
*.tsbuildinfo
.vite/
vite.config.ts.timestamp-*

# Packed browser extension (load the folder unpacked; store builds are made from it)
keys-extension/*.crx
keys-extension/*.zip

# ---------------------------------------------------------------- caches and test output
.cache/
.eslintcache
.stylelintcache
.prettiercache
.turbo/
coverage/
.nyc_output/
test-results/
*.lcov

# ---------------------------------------------------------------- logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------- secrets and local config
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.mobileprovision
*.keystore

# ---------------------------------------------------------------- vaults and exports
# A Keys database or backup must never be committed, even an encrypted one.
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal
*.merged
*.keys.json
keys-*-UNENCRYPTED.*
.*.open-*.json
browsers.json
location.json
device.json

# ---------------------------------------------------------------- operating systems
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory

# ---------------------------------------------------------------- editors and tools
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
.history/
.claude/
.impeccable/
CLAUDE.md
AGENTS.md
.github/

# ---------------------------------------------------------------- archives
*.zip
*.tar.gz
*.tgz

# ---------------------------------------------------------------- local only
# The previous single-folder layout, kept until it's deleted.
keys-old/
