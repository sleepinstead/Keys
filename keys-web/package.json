{
  "name": "keys-web",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "description": "Keys in the browser: the app and its vault, served by Node on 127.0.0.1:5174.",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "setup": "npm install",
    "build": "npm run typecheck && vite build",
    "start": "node server/index.ts --production",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json",
    "test": "node --import ./test/env.ts --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "@types/express": "^5.0.6"
  }
}
