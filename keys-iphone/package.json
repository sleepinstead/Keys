{
  "name": "keys-iphone",
  "private": true,
  "version": "1.0.0",
  "description": "Keys for iPhone: a read-only web app that opens your Keys file from Google Drive.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "vite --config vite.phone.config.ts",
    "build": "npm run typecheck && vite build --config vite.phone.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "hash-wasm": "^4.13.0",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.4.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
